---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { tenant } from "../../../config/tenant";
import { getCollection } from "astro:content";

export const prerender = true;
export function getStaticPaths() {
  return [{ params: { lang: "fr" } }];
}

const { lang } = Astro.params as { lang: string };
const currentPath = `/${lang}/blog`;

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => (b.data.date ?? "").localeCompare(a.data.date ?? ""));

const title = `Blogue TI — ${tenant.name}`;
const description =
  "Articles pratiques sur la cybersécurité, Microsoft 365, la conformité Loi 25 et la gestion TI pour coopératives et OBNL au Québec.";

const kickerMap: Record<string, string> = {
  "loi-25-conformite-cooperative-obnl-quebec": "Dossier conformité",
  "7-reglages-microsoft-365-cooperative-obnl": "Microsoft 365",
  "depart-employe-acces-mots-de-passe-cooperative": "Sécurité d'accès",
  "antivirus-vs-edr-cooperative-obnl": "Cybersécurité",
  "cout-reel-gestion-informatique-interne-cooperative": "Analyse économique",
  "cas-cooperative-habitation-incidents-ti-divises": "Habitation",
};

const featured = posts[0];
const rest = posts.slice(1);
---

<SiteLayout title={title} description={description} lang={lang} currentPath={currentPath}>
  <style>
    .glass-card {
      border: 1px solid rgba(255,255,255,0.06);
      box-shadow: 0 20px 40px rgba(0,0,0,0.45), 0 4px 12px rgba(0,0,0,0.25), 0 0 0 1px rgba(255,255,255,0.07);
    }
  </style>

  <!-- HEADER SLOT -->
  <div slot="header" class="flex flex-col items-center">
    <img src={tenant.logoSrc} alt={tenant.name} class="h-28 md:h-36 w-auto drop-shadow-lg" fetchpriority="high" loading="eager" />
    <p class="mt-3 text-sm tracking-[0.35em] uppercase animate-fade-up animate-fade-up-delay-1"
       style="color: color-mix(in srgb, var(--text) 55%, transparent);">
      Ressources &amp; Conseils
    </p>
  </div>

  <!-- HERO SLOT -->
  <div slot="hero" class="relative max-w-5xl mx-auto text-center z-10 py-8 px-4">
    <p class="text-xs uppercase tracking-[0.35em] animate-fade-up"
       style="color: color-mix(in srgb, var(--accent) 85%, transparent);">
      Journal TI
    </p>
    <h1 class="mt-4 text-4xl md:text-6xl font-bold tracking-tight leading-tight animate-fade-up animate-fade-up-delay-1"
        style="color: var(--text);">
      Blogue
    </h1>
    <p class="mt-5 text-base md:text-lg leading-relaxed mx-auto max-w-3xl animate-fade-up animate-fade-up-delay-2"
       style="color: color-mix(in srgb, var(--text) 78%, transparent);">
      {description}
    </p>
  </div>

  <!-- MAIN CONTENT -->
  <main>
    <!-- Gold divider -->
    <section class="relative w-full">
      <div class="h-[2px] w-full" style="background: var(--accent);"></div>
      <div class="h-10 w-full"
           style="background: linear-gradient(to bottom, color-mix(in srgb, var(--accent) 14%, transparent), transparent);"></div>
    </section>

    <section class="relative w-full" style="background: var(--band);">
      <div class="mx-auto max-w-6xl px-4 py-16">

        <!-- Section header -->
        <div class="text-center reveal mb-10">
          <h2 class="text-md uppercase tracking-[0.35em]" style="color: rgba(17,17,17,0.55);">
            {posts.length} articles publiés
          </h2>
        </div>

        <!-- FEATURED ARTICLE -->
        {featured && (
          <a
            href={`/${lang}/blog/${featured.data.url_slug}`}
            class="group relative overflow-hidden rounded-2xl md:col-span-3 glass-card p-8 md:p-10 flex flex-col gap-4 reveal block mb-6"
            style="background: var(--card);"
          >
            <!-- Hover overlay -->
            <div class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition duration-300"
                 style="background: radial-gradient(circle at 15% 50%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 60%);"></div>
            <!-- Ambient glow -->
            <div class="pointer-events-none absolute -top-20 -right-20 h-72 w-72 rounded-full blur-3xl opacity-40"
                 style="background: color-mix(in srgb, var(--accent) 22%, transparent);"></div>

            <div class="relative z-10 max-w-3xl">
              <div class="flex items-center gap-3 mb-3">
                <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold"
                      style="background: color-mix(in srgb, var(--accent) 15%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); color: var(--accent);">
                  {kickerMap[featured.data.url_slug] ?? featured.data.angle}
                </span>
                <span class="text-xs" style="color: color-mix(in srgb, var(--text) 45%, transparent);">
                  À la une
                </span>
              </div>
              <h2 class="text-2xl md:text-3xl font-extrabold leading-snug" style="color: var(--text);">
                {featured.data.title}
              </h2>
              <p class="mt-3 text-sm md:text-base leading-relaxed max-w-2xl"
                 style="color: color-mix(in srgb, var(--text) 72%, transparent);">
                {featured.data.meta_description}
              </p>
              <span class="mt-6 inline-flex items-center justify-center rounded-xl px-6 py-3 font-semibold transition group-hover:brightness-110"
                    style={`background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 92%, white 8%), color-mix(in srgb, var(--accent) 72%, black 28%)); color: #111;`}>
                Lire l'article →
              </span>
            </div>
          </a>
        )}

        <!-- ARTICLE GRID -->
        {rest.length > 0 && (
          <div class="grid gap-6 md:grid-cols-3">
            {rest.map((post, i) => (
              <a
                href={`/${lang}/blog/${post.data.url_slug}`}
                class="group relative overflow-hidden rounded-2xl glass-card p-6 flex flex-col reveal"
                style={`animation-delay: ${i * 0.05}s; background: var(--card);`}
              >
                <!-- Hover tint -->
                <div class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition duration-300"
                     style="background: radial-gradient(circle at 20% 20%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 55%);"></div>

                <div class="relative flex flex-col gap-3 h-full">
                  <span class="inline-flex self-start items-center rounded-full px-2.5 py-0.5 text-xs font-semibold"
                        style="background: color-mix(in srgb, var(--accent) 12%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent); color: var(--accent);">
                    {kickerMap[post.data.url_slug] ?? post.data.angle}
                  </span>
                  <h3 class="text-lg font-semibold leading-snug" style="color: var(--text);">
                    {post.data.title}
                  </h3>
                  <p class="text-sm leading-relaxed line-clamp-3 flex-1"
                     style="color: color-mix(in srgb, var(--text) 70%, transparent);">
                    {post.data.meta_description}
                  </p>
                  <span class="mt-2 inline-flex items-center text-sm font-semibold transition group-hover:translate-x-1 duration-200"
                        style="color: var(--accent);">
                    Lire l'article →
                  </span>
                </div>
              </a>
            ))}
          </div>
        )}

      </div>
    </section>
  </main>
</SiteLayout>
